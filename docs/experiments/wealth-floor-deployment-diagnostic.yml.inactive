# DORMANT: source review required before a separate exact activation copy.
name: Wealth-floor deployment-only diagnostic

on:
  push:
    branches: [lead/wealth-floor-deployment-diagnostic-activation-20261029]
    paths: [.github/workflows/wealth-floor-deployment-diagnostic.yml]

permissions:
  contents: read

jobs:
  observe:
    name: Deployment-only observation
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    env:
      PYTHONUNBUFFERED: "1"
      PYTHONDONTWRITEBYTECODE: "1"
      PYTHONPATH: ""
      PYTHON_CPU_COUNT: "1"
      OMP_NUM_THREADS: "1"
      OPENBLAS_NUM_THREADS: "1"
      MKL_NUM_THREADS: "1"
      NUMEXPR_NUM_THREADS: "1"
      VECLIB_MAXIMUM_THREADS: "1"
      RAYON_NUM_THREADS: "1"
    steps:
      - name: Check out exact reviewed control
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - name: Set up stdlib-only interpreter
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.13"
      - name: Verify checkout and inert default
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          git diff --exit-code
          python scripts/wealth_floor_deployment_diagnostic.py
      - name: Observe bounded deployment metadata
        shell: bash
        run: |
          set -euo pipefail
          python scripts/wealth_floor_deployment_diagnostic.py --observe \
            --output "$RUNNER_TEMP/wealth-floor-deployment-diagnostic.json"
      - name: Retain observation-only receipt
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: wealth-floor-deployment-diagnostic-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/wealth-floor-deployment-diagnostic.json
          if-no-files-found: warn
          retention-days: 30
