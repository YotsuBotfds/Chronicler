    {
      "id": "R3",
      "name": "Pin transition",
      "goal": "Refactors gated by behaviour, not source bytes; history still verifiable"
    },
    {
      "id": "R4",
      "name": "Corrections",
      "goal": "Each verified outcome bug fixed in its own baselined, signed-off PR"
    },
    {
      "id": "R5",
      "name": "Relocate and consolidate",
      "goal": "Lab code out of the package; adding a system touches one module and one registry"
    },
    {
      "id": "R6",
      "name": "Deep core",
      "goal": "Core stats carry information, money is conserved, welfare is measured, runs are reproducible by profile"
    },
    {
      "id": "R7",
      "name": "Breadth",
      "goal": "New mechanisms on the consolidated core, each default-off and gated"
    }
  ],
