    "base_revision": "dae4ba5",
    "description": "Corrected oracle rolled forward by the 2026-10 population and entity-lifecycle corrections (docs/integration/population-entities.md). Captured with the exact capture loops of tests/test_performance_equivalence.py and tests/test_governance_dormancy.py in Python off mode with the native ecology/politics runtimes disabled. Each workload index is the first turn that correction moves relative to the capture with all earlier corrections applied (consecutive captures). corrected_open_items_2026_10 and older fixtures remain frozen; workloads not named in 'corrections' are byte-identical to it.",
    "corrections": [
      {
        "id": "PE-ARRIVALS",
        "summary": "utils.add_region_pop caps the accepted increment (max(0, min(amount, cap - population))) instead of the resulting population: arrivals in a region above its effective capacity no longer remove residents. Growth, repopulation and immigration are refused where there is no room; overflow migrants and famine refugees a full region cannot take die on the way.",
        "workloads": {
          "single": 16,
          "standard": 11,
          "wide": 0
        }
      },
      {
        "id": "PE-REFUGEES",
        "summary": "Famine refugees: the drained people are split exactly among the foreign neighbours (equal shares, the remainder one at a time in region-index order) instead of max(1, drain // n) each; only neighbours offered refugees take the stability cost.",
        "workloads": {
          "standard": 9,
          "wide": 5
        }
      },
      {
        "id": "PE-AGENT-ONLY",
        "summary": "Founder deaths through the permanent agent registry, faith slots kept by tolerations and living movements, conserved initial occupation shares, slot-space coincident repulsion and mineral depletion by realized extraction act in agent modes only.",
        "workloads": {}
      }
    ],
    "environment": {
      "python": "3.13.17",
      "platform": "Linux"
    },
    "comparison": "complete emitted file set, byte count and SHA256; no field filtering or tolerance",
    "projections": "workloads: bundle version 5 bytes (scripts/third_wave_controls.py projection); pre_pruning_workloads: the same run projected to bundle version 4 (legacy_artifact_bytes(pre_pruning=True))."
  },
