    "base_revision": "98ba9a2",
    "description": "Corrected oracle rolled forward by the 2026-10 food-logistics changes (docs/integration/food-logistics-2026-10.md). Captured with the exact capture loops of tests/test_performance_equivalence.py and tests/test_governance_dormancy.py in Python off mode with the native ecology/politics runtimes disabled. Changes are listed in commit order; each workload index is the first turn that change moves relative to the oracle with all earlier changes applied (consecutive captures of the branch commits). corrected_food_balance_2026_10 and older fixtures remain frozen; workloads not named in 'corrections' are byte-identical to it.",
    "corrections": [
      {
        "id": "FL-MERCHANT-FOOD-PRICE",
        "summary": "Merchants carry food where its price (demand / supply = 1 / food sufficiency) is higher than at home and never to a region without people; other goods keep the market-activity proxy (destination merchant_route_margin) and never displace food.",
        "workloads": {},
        "note": "Native agent runtime only; the off-mode oracle lane does not run merchants."
      },
      {
        "id": "FL-SUBSISTENCE",
        "summary": "The goods economy forages grain at M34's subsistence baseline (in goods) when no food slot yields: barren food slots' labor forages; without a food slot foraging joins the food-first split.",
        "workloads": {},
        "note": "Agent modes only; off mode does not run the goods economy."
      },
      {
        "id": "FL-LOCUST-RATE",
        "kind": "recalibration",
        "summary": "Locust swarm chance per eligible turn 0.15 -> 0.02 (M35b placeholder; about 11% of eligible region-years instead of 62%).",
        "workloads": {
          "standard": 3,
          "wide": 3
        }
      }
    ],
    "environment": {
      "python": "3.13.17",
      "platform": "Linux"
    },
    "comparison": "complete emitted file set, byte count and SHA256; no field filtering or tolerance",
    "projections": "workloads: bundle version 5 bytes (scripts/third_wave_controls.py projection); pre_pruning_workloads: the same run projected to bundle version 4 (legacy_artifact_bytes(pre_pruning=True))."
  },
